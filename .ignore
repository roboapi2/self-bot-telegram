# Real root configuration and local backup copies; examples stay visible.
/config.php
/config.php.*
.env
.env.*
!.env.example

# Private runtime: sessions/DBs, QR/2FA, media, archives and process locks.
# Legacy account PHP may contain secrets: review a sanitized copy outside accounts/.
/accounts/
/.panel/
/accounts.json
/accounts.json.*
/accounts.lock

# Stray session/auth/process files outside the normal runtime trees.
session.madeline*
qr_2fa.secret*
qr_state.json
*.pid
*.lock.tmp
*.tmp
*.tmp.*
*.log
*.log.*
*.bak
*.backup

# composer.lock is source; dependencies and local output are not.
/vendor/
/releases/
/backups/
/backup_beta/
/extracted/
/audit/
__pycache__/
*.pyc
*.pyo

# Observed local AI settings; future shared commands remain eligible.
/.claude/settings.local.json

# Generated graph/cache output; retain useful architecture documentation.
/graphify-out/*
!/graphify-out/ARCHITECTURE_FA.md
!/graphify-out/GRAPH_REPORT.md

# Local Docker deployment state and credentials (public docker/ source stays visible)
/data/
/secrets/
/state/
/settings.env
compose.override.yml
compose.override.yaml
